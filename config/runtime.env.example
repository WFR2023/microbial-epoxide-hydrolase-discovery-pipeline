# Required for NCBI Entrez queries.
# Use your own valid contact email.
export NCBI_EMAIL="your.email@example.org"

# Optional. If available, provide your NCBI API key through the environment.
# Never store API keys in the repository.
# export NCBI_API_KEY="your_ncbi_api_key"

# Required for the Pfam/HMMER stage.
export PFAM_DB="/path/to/Pfam-A.hmm"

# IMPORTANT:
# Run the workflow from the root of the study working directory.
# The canonical scripts use relative paths and do not depend on the
# original authors' local filesystem.
